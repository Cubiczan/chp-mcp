{
  "name": "@cubiczan/chp-mcp",
  "version": "0.1.0",
  "description": "MCP server for CHP Profile B \u2014 evaluate_spend_gate and approve_spend over @cubiczan/chp",
  "mcpName": "io.github.icohangar-ops/chp-mcp",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "chp-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const p='dist/index.js';let t=fs.readFileSync(p,'utf8');if(!t.startsWith('#!'))fs.writeFileSync(p,'#!/usr/bin/env node\\n'+t);fs.chmodSync(p,0o755)\"",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "chp",
    "consensus-hardening",
    "spend-gate",
    "finance",
    "governance"
  ],
  "author": "Shyam Desigan <sam@cubiczan.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icohangar-ops/cubiczan-chp-mcp.git"
  },
  "homepage": "https://github.com/icohangar-ops/cubiczan-chp-mcp#readme",
  "bugs": {
    "url": "https://github.com/icohangar-ops/cubiczan-chp-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cubiczan/chp": "^0.1.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
